{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LmStudio": {
    "BaseUrl": "http://localhost:1234",
    "Model": "google_gemma-4-26b-a4b-it",
    "TimeoutSeconds": 60,
    "Temperature": 0.3,
    "MaxTokens": 400
  },
  "AnomalyDetection": {
    "ThresholdMultiplier": 3.0,
    "MinBaselineSamples": 5,
    "MinAbsoluteDeltaMs": 5.0
  },
  "Graphify": {
    "_comment": "graphify CLI(uv tool install graphifyy)로 만드는 코드 지식그래프 연동 설정. ServerSourceDirs는 예시입니다 — 실제 경로는 appsettings.Local.json에 넣으세요.",
    "CliPath": "graphify",
    "TimeoutSeconds": 30,
    "MaxContextChars": 3000,
    "ServerSourceDirs": {
      "TargetServer": "C:\\path\\to\\your\\target-server-source"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ManagedServers": [
    {
      "_comment": "여기는 예시 형식입니다. 실제 경로는 appsettings.Local.json(gitignore됨)에 넣으세요.",
      "Name": "예시 서버",
      "WorkingDirectory": "C:\\path\\to\\your\\server",
      "Command": "dotnet",
      "Arguments": "run --urls http://localhost:5082"
    }
  ]
}
